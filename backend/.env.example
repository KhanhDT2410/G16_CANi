# =============================================================================
# CANi Backend - Môi trường biến mẫu (Environment Configuration)
# Hướng dẫn kết nối cơ sở dữ liệu Supabase PostgreSQL
# =============================================================================

# 1. Lấy thông tin từ Supabase Dashboard:
#    Project Settings -> Database -> Connection String -> URI / JDBC

# CÁCH 1: Direct Connection (Session Mode) - Khuyên dùng cho Flyway Migration
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD

# CÁCH 2: Dùng Connection Pooler (Nếu mạng nhà mạng FPT/Viettel chưa hỗ trợ IPv6 đến Supabase)
# Lưu ý: Bắt buộc chọn "Session mode" (Port 5432), KHÔNG chọn Transaction mode (Port 6543) vì Flyway cần DDL transaction
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD

# Cổng chạy ứng dụng Spring Boot
SERVER_PORT=8080
