# =============================================================================
# CANi Backend - Environment variables template
# Copy to backend/.env (gitignored) and fill real values. NEVER commit backend/.env.
# =============================================================================

# Spring profile: local (default) | supabase
# SPRING_PROFILES_ACTIVE=local

# --- Database (Supabase PostgreSQL) ---
# Direct connection (session mode, port 5432) - required for Flyway DDL transactions
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD
# Pooler alternative (if your network lacks IPv6): use Session mode port 5432, NOT 6543
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]

# --- Supabase Auth ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
# service_role bypasses Row Level Security - server-side only, rotate if ever exposed
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini AI (skill document verification, UC-46) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server ---
SERVER_PORT=8080

# --- Firebase Admin SDK ---
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# --- VNPay Sandbox ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- PayOS Gateway ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- VNPT eKYC (Identity Verification, UC-12/13) ---
# Default is disabled unless explicit credentials provided. NEVER commit real credentials.
VNPT_EKYC_ENABLED=false
VNPT_EKYC_BASE_URL=https://api.idg.vnpt.vn
VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_ACCESS_TOKEN=
VNPT_EKYC_MAC_ADDRESS=
# Optional contract-verified VNPT parameters (leave blank until confirmed against VNPT API contract):
# VNPT_EKYC_VERIFY_BACK_CARD=true
# VNPT_EKYC_OCR_BACK_PATH=/ai/v1/ocr/id/back
# VNPT_EKYC_FACE_MATCH_MIN_THRESHOLD=
# VNPT_EKYC_FACE_MATCH_SCORE_MAX=
# VNPT_EKYC_CARD_LIVENESS_ENABLED=false
# VNPT_EKYC_CARD_LIVENESS_PATH=
# VNPT_EKYC_FACE_LIVENESS_ENABLED=false
# VNPT_EKYC_FACE_LIVENESS_PATH=
# VNPT_EKYC_REQUIRE_LIVENESS_FOR_AUTO_APPROVE=true

# --- eKYC Private Image Storage & Signing ---
EKYC_STORAGE_DIR=uploads/ekyc-private
EKYC_IMAGE_SIGNING_SECRET=
EKYC_IMAGE_URL_TTL_SECONDS=180
EKYC_HASH_PEPPER=
EKYC_RETENTION_APPROVED_DAYS=0
EKYC_RETENTION_REJECTED_DAYS=0
EKYC_RETENTION_TECH_FAILURE_DAYS=0
EKYC_RETENTION_PENDING_REVIEW_DAYS=0
EKYC_RETENTION_CLEANUP_ENABLED=false
EKYC_RETENTION_ORPHAN_GRACE_HOURS=0


