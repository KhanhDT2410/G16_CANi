# =============================================================================
# CANi Backend - Environment variables template
# Copy to backend/.env (gitignored) and fill real values. NEVER commit backend/.env.
# =============================================================================

# Spring profile: local (default) | supabase
# SPRING_PROFILES_ACTIVE=local

# --- Database (Supabase PostgreSQL) ---
# Direct connection (session mode, port 5432) - required for Flyway DDL transactions
DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD
# Pooler alternative (if your network lacks IPv6): use Session mode port 5432, NOT 6543
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]

# --- Supabase Auth ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
# service_role bypasses Row Level Security - server-side only, rotate if ever exposed
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini AI (skill document verification, UC-46) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server ---
SERVER_PORT=8080

# --- Firebase Admin SDK ---
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# --- VNPay Sandbox ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- PayOS Gateway ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
