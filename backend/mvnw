#!/bin/sh
# Maven Wrapper startup script for Unix

set -e

# Resolve script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_BASE_NAME="$(basename "$0")"
APP_HOME="$(cd "$(dirname "$0")" && pwd)"

# Add default JVM options
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Build the classpath
CLASSPATH="$APP_HOME/.mvn/wrapper/maven-wrapper.jar"

# Download wrapper jar if not exists
WRAPPER_JAR="$APP_HOME/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
    else
        echo "ERROR: Neither curl nor wget found. Please install one of them."
        exit 1
    fi
fi

# Determine JAVA executable
JAVACMD="java"
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
elif [ -x "/c/Program Files (x86)/Java/jdk-21.0.2/bin/java" ]; then
    JAVACMD="/c/Program Files (x86)/Java/jdk-21.0.2/bin/java"
elif [ -x "C:/Program Files (x86)/Java/jdk-21.0.2/bin/java.exe" ]; then
    JAVACMD="C:/Program Files (x86)/Java/jdk-21.0.2/bin/java.exe"
fi

# Execute Maven
exec "$JAVACMD" $DEFAULT_JVM_OPTS \
    -classpath "$CLASSPATH" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"
