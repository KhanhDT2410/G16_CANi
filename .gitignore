# ============================================
# CANi Monorepo - Shared Gitignore
# ============================================

# Java / Maven - Backend
backend/target/
backend/*.log
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# Node / React - Web
web/node_modules/
web/dist/
web/dist-ssr/
web/.env
web/.env.local
web/.env.*.local

# Flutter / Dart - Mobile
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/.flutter-plugins-cache/
mobile/.symlinks/
mobile/android/.gradle/
mobile/android/app/build/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/macos/Pods/
mobile/macos/.symlinks/

# IDE & AI Tooling
.idea/
.vscode/
.agents/
.claude/
*.iml
*.iws
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets and sensitive files
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
.cache/
