# =============================================================================
# CANi Infrastructure - Local Development Environment
# Copy to .env and adjust values as needed
# =============================================================================

# PostgreSQL
POSTGRES_DB=cani_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin
PGADMIN_EMAIL=admin@cani.local
PGADMIN_PASSWORD=admin

# Backend (optional - for docker-compose backend service)
# SERVER_PORT=8080
# DB_URL=jdbc:postgresql://postgres:5432/cani_dev
# DB_USERNAME=postgres
# DB_PASSWORD=postgres